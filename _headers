# Cloudflare Pages — https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Content-Security-Policy: default-src 'none'; img-src 'self'; style-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

# Assets carry a version in the filename (style.v1.css), so they can be cached hard.
# Bump the version in the filename when you change one.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML always revalidates, so content edits go live immediately.
/
  Cache-Control: public, max-age=0, must-revalidate
/gr/
  Cache-Control: public, max-age=0, must-revalidate
/404.html
  Cache-Control: public, max-age=0, must-revalidate
